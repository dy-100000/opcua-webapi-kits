{
  "name": "opcua-webservice-node",
  "version": "1.0.3",
  "description": "",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "package.json"
  ],
  "scripts": {
    "generate": "openapi-generator-cli generate -i opc.ua.openapi.allservices.json -g nodejs-express-server -o src",
    "dev": "tsx watch --clear-screen=false examples/testserver/Application.ts",
    "typecheck": "tsc --noEmit",
    "build": "tsc",
    "postbuild": "node -e \"const fs=require('fs'); const path=require('path'); const src=path.join(process.cwd(),'src','api','openapi.yaml'); const destDir=path.join(process.cwd(),'dist','api'); const dest=path.join(destDir,'openapi.yaml'); fs.mkdirSync(destDir,{recursive:true}); fs.copyFileSync(src,dest);\"",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "body-parser": "^2.2.2",
    "camelcase": "^5.3.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-openapi-validator": "^5.6.2",
    "opcua-webapi": "^1.504.2",
    "opcua-webapi-ts": "^1.1.10",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^25.3.3",
    "eslint": "^10.0.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "author": "",
  "license": "ISC"
}
