{
  "name": "opcua-webapi-ts",
  "version": "1.1.12",
  "description": "Provides OPC UA WebAPI wrapper and client based on opcua-webapi-typescript",
  "author": "DingYan",
  "license": "MIT",
  "main": "./dist/cjs/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/cjs/index.js",
      "default": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/**/*"
  ],
  "keywords": [
    "opcua",
    "opc-ua",
    "webapi",
    "typescript"
  ],
  "scripts": {
    "build": "tsc && tsc -p tsconfig.cjs.json",
    "prepare": "npm run build",
    "dev": "tsx watch --clear-screen=false test/test.ts"
  },
  "dependencies": {
    "opcua-webapi": "^1.504.2"
  },
  "devDependencies": {
    "tsx": "^4.22.3",
    "typescript": "^6.0.3"
  }
}
