{
  "name": "opcua-webclient-ts",
  "version": "1.0.12",
  "description": "Provides OPC UA WebClient wrapper based on opcua-webapi-typescript",
  "author": "DingYan",
  "main": "./dist/cjs/index.js",
  "typings": "./dist/index.d.ts",
